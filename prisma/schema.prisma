// Local DB schema. SQLite for dev; swap to postgres in production by
// changing the datasource and DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- NextAuth (Auth.js) tables ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Local username (ID) — primary login identifier for credentials provider.
  username      String?   @unique
  // PIN hash (bcrypt). Null for OAuth-only users.
  passwordHash  String?

  accounts  Account[]
  sessions  Session[]
  events    Event[]
  weights   WeightEntry[]
  assets    AssetEntry[]
  photos    Photo[]
  wikiPages WikiPage[]
  pushSubs  PushSubscription[]
}

// --- Wiki (Notion-like) ---
model WikiPage {
  id        String     @id @default(cuid())
  userId    String
  parentId  String?
  title     String     @default("새 페이지")
  icon      String?
  content   String     @default("")
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   WikiPage?  @relation("WikiPageParent", fields: [parentId], references: [id], onDelete: Cascade)
  children WikiPage[] @relation("WikiPageParent")

  @@index([userId, parentId])
}

// --- Web Push subscription ---
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Weight tracking ---
model WeightEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  kg        Float
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// --- Asset / finance tracking ---
model AssetEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  label     String
  // KRW total snapshot
  amount    Int
  category  String? // 현금/주식/암호화폐/부동산 등
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// --- Gallery ---
model Photo {
  id        String   @id @default(cuid())
  userId    String
  // Local path under /public/uploads or remote URL
  url       String
  width     Int?
  height    Int?
  caption   String?
  takenAt   DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, takenAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App tables ---
model Event {
  id          String   @id @default(cuid())
  userId      String
  // Google Calendar event id when synced; null = local-only
  googleId    String?  @unique
  calendarId  String   @default("primary")
  title       String
  description String?
  location    String?
  start       DateTime
  end         DateTime
  allDay      Boolean  @default(false)
  color       String?
  // Mood emoji, e.g. "😊"
  mood        String?
  // last successful sync timestamp from Google
  syncedAt    DateTime?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, start])
  @@index([userId, end])
}
