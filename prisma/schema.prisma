// Local DB schema. SQLite for dev; swap to postgres in production by
// changing the datasource and DATABASE_URL.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// --- NextAuth (Auth.js) tables ---
model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  // Local username (ID) — primary login identifier for credentials provider.
  username      String?   @unique
  // PIN hash (bcrypt). Null for OAuth-only users.
  passwordHash  String?
  // Google Calendar ICS (iCal) secret address — read-only subscribe URL.
  icalUrl       String?
  // 목표 체중 (kg). 체중 탭 차트에 가로 기준선으로 표시.
  targetWeightKg Float?
  // 공용 게시판 새 글 알림 받기
  boardNotify Boolean @default(true)
  // Notion Integration internal token + chosen workspace name (display).
  notionToken     String?
  notionWorkspace String?

  accounts  Account[]
  sessions  Session[]
  events    Event[]
  weights   WeightEntry[]
  assets    AssetEntry[]
  photos    Photo[]
  wikiPages WikiPage[]
  pushSubs  PushSubscription[]
  todos     Todo[]
  goals     Goal[]
  posts     Post[]
  postComments PostComment[]
}

// --- 공용 게시판 (두 사용자 공유) ---
model Post {
  id        String   @id @default(cuid())
  authorId  String
  content   String   @default("")
  // 게시판 카테고리 (일반/여행/음식/추억 등 — 자유 문자열)
  category  String   @default("일반")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author   User          @relation(fields: [authorId], references: [id], onDelete: Cascade)
  images   PostImage[]
  comments PostComment[]

  @@index([createdAt])
  @@index([category])
}

model PostImage {
  id     String @id @default(cuid())
  postId String
  url    String
  width  Int?
  height Int?
  order  Int    @default(0)

  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model PostComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())

  post   Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId])
}

// --- Dashboard: daily TODO + year/month goals ---
model Todo {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime // day-level (midnight local) — anchor for the daily list
  text      String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Goal {
  id        String   @id @default(cuid())
  userId    String
  year      Int
  month     Int? // null = year goal, 1-12 = month goal
  text      String
  done      Boolean  @default(false)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, year, month])
}

// --- Wiki (Notion-like) ---
model WikiPage {
  id        String     @id @default(cuid())
  userId    String
  parentId  String?
  title     String     @default("새 페이지")
  icon      String?
  content   String     @default("")
  order     Int        @default(0)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  user     User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent   WikiPage?  @relation("WikiPageParent", fields: [parentId], references: [id], onDelete: Cascade)
  children WikiPage[] @relation("WikiPageParent")

  @@index([userId, parentId])
}

// --- Web Push subscription ---
model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// --- Weight tracking ---
model WeightEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  kg        Float
  note      String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// --- Asset / finance tracking ---
model AssetEntry {
  id        String   @id @default(cuid())
  userId    String
  date      DateTime
  label     String
  // KRW total snapshot
  amount    Int
  category  String? // 현금/주식/암호화폐/부동산 등
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

// --- Gallery ---
model Photo {
  id        String   @id @default(cuid())
  userId    String
  // Local path under /public/uploads or remote URL
  url       String
  width     Int?
  height    Int?
  caption   String?
  takenAt   DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, takenAt])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- App tables ---
model Event {
  id          String   @id @default(cuid())
  userId      String
  // Google Calendar event id when synced; null = local-only
  googleId    String?  @unique
  calendarId  String   @default("primary")
  title       String
  description String?
  location    String?
  start       DateTime
  end         DateTime
  allDay      Boolean  @default(false)
  color       String?
  // Mood emoji, e.g. "😊"
  mood        String?
  // 공용 일정 — true면 다른 유저 캘린더에도 표시
  shared      Boolean  @default(false)
  // 알림: 시작 N분 전. null = 알림 없음. 0 = 정각.
  notifyMinutes Int?
  // 마지막 알림 발송 시각 (중복 발송 방지)
  notifiedAt    DateTime?
  // last successful sync timestamp from Google
  syncedAt    DateTime?
  updatedAt   DateTime @updatedAt
  createdAt   DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, start])
  @@index([userId, end])
}
